<?xml version="1.0"?>
<robot name="robot_arm">

  <material name="blue">
    <color rgba="0.2 0.4 0.9 1"/>
  </material>

  <material name="orange">
    <color rgba="0.95 0.5 0.1 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.12" length="0.1"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>



  <!-- Torso rotates around the vertical Z-axis -->
  <joint name="torso_yaw_joint" type="revolute">
      <parent link="base_link"/>
      <child link="torso_link"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57"
            effort="10" velocity="1"/>
  </joint>

  <!-- Simplified torso -->
  <link name="torso_link">
      <visual>
          <origin xyz="0 0 0.15"/>
          <geometry>
              <box size="0.3 0.18 0.3"/>
          </geometry>
          <material name="blue"/>
      </visual>
  </link>



  <!-- Shoulder rotation around vertical Z-axis -->
  <joint name="shoulder_yaw_joint" type="revolute">
      <parent link="torso_link"/>
      <child link="shoulder_link"/>
      <origin xyz="-0.15 0 0.30" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <!-- Intermediate link connecting two shoulder joints -->
  <link name="shoulder_link">
      <visual>
          <geometry>
              <sphere radius="0.07"/>
          </geometry>
          <material name="blue"/>
      </visual>
  </link>

  <!-- Original shoulder pitch rotation -->
  <joint name="shoulder_joint" type="revolute">
      <parent link="shoulder_link"/>
      <child link="upper_arm"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <box size="0.08 0.08 0.5"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" effort="10" velocity="1"/>
  </joint>

  <link name="forearm">
    <visual>
      <origin xyz="0 0 0.2"/>
      <geometry>
        <box size="0.06 0.06 0.4"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

</robot>